+// Android owns the TUN through VpnService. Change only the live routing mode.
+func patchEmbeddedMode(w http.ResponseWriter, r *http.Request) {
+	var fields map[string]*tunnel.TunnelMode
+	if err := render.DecodeJSON(r.Body, &fields); err != nil || len(fields) != 1 || fields["mode"] == nil {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, ErrBadRequest)
+		return
+	}
+	tunnel.SetMode(*fields["mode"])
+	render.NoContent(w, r)
+}
