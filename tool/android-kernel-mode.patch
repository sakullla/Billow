+package route
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/metacubex/http/httptest"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+func TestBillowEmbeddedMode(t *testing.T) {
+	previousEmbed, previousMode := embedMode, tunnel.Mode()
+	defer SetEmbedMode(previousEmbed)
+	defer tunnel.SetMode(previousMode)
+	SetEmbedMode(true)
+	routes := configRouter()
+
+	for _, mode := range []string{"global", "direct", "rule"} {
+		response := httptest.NewRecorder()
+		routes.ServeHTTP(response, httptest.NewRequest("PATCH", "/", strings.NewReader(`{"mode":"`+mode+`"}`)))
+		if response.Code != 204 || tunnel.Mode().String() != mode {
+			t.Fatalf("switch to %s: HTTP %d, live mode %s", mode, response.Code, tunnel.Mode())
+		}
+	}
+	for _, body := range []string{`{}`, `{"mode":"unknown"}`, `{"mode":null}`, `{"mixed-port":7890}`, `{"mode":"global","tun":{}}`} {
+		response := httptest.NewRecorder()
+		routes.ServeHTTP(response, httptest.NewRequest("PATCH", "/", strings.NewReader(body)))
+		if response.Code != 400 || tunnel.Mode() != tunnel.Rule {
+			t.Fatalf("unexpected change for %s: HTTP %d, live mode %s", body, response.Code, tunnel.Mode())
+		}
+	}
+	response := httptest.NewRecorder()
+	routes.ServeHTTP(response, httptest.NewRequest("PUT", "/", nil))
+	if response.Code != 405 {
+		t.Fatalf("full config update: HTTP %d", response.Code)
+	}
+}

