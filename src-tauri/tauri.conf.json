{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Billow",
  "version": "0.1.54",
  "identifier": "app.billow.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node tool/prepare_runtime.mjs && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Billow",
        "width": 960,
        "height": 680,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "billow"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "billow"
          ],
          "host": "install-config"
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMzRGNTU3RDBCOUM4QUQKUldTdHlMblFWL1UwbzhEcFZmTDR4NlJ5ejlpcGhnR3pnM2RzeVNxdmM4UnZ5aDVIM1hZZ1pnZXQK",
      "endpoints": [
        "https://github.com/sakullla/Billow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Billow",
    "longDescription": "Billow。以 GPL-3 许可发布。",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  }
}
