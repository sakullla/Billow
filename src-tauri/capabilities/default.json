    "allow-cancel-install-link",
    "allow-enable-profile",
    "allow-update-profile",
    "allow-save-profile-override",
    "allow-preview-profile-override",
    "allow-connect-session",
    "allow-disconnect-session",
    "allow-set-system-proxy",
    "allow-set-tun-enabled",
    "allow-exclude-package",
    "allow-include-package",
    "allow-set-app-rules",
    "allow-select-profile-node",
    "allow-unfix-profile-group",
    "allow-test-profile-group",
    "allow-set-node-query",
    "allow-set-node-sort",
    "allow-set-connection-query",
    "allow-set-log-filter",
    "allow-preview-custom-nodes-import",
    "allow-import-custom-nodes",
    "allow-save-custom-node",
    "allow-delete-custom-node",
    "allow-set-custom-node-enabled",
    "allow-set-custom-nodes-overlay",
    "allow-save-landing-rules",
    "allow-use-custom-profile",
    "allow-set-outbound-mode",
    "allow-delete-profile",
    "allow-rename-profile",
    "allow-set-profile-source",
    "allow-set-profile-user-agent",
    "allow-set-profile-interval",
    "allow-set-profile-age-key",
    "allow-profile-content",
    "allow-effective-config",
    "allow-config-overview",
    "allow-lan-address",
    "allow-save-profile-content",
    "allow-refresh-profile",
    "allow-refresh-all-profiles",
    "allow-save-kernel-settings",
    "allow-test-all-nodes",
    "allow-test-node",
