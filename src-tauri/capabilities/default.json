{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Billow 主窗口使用的默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-shell-state",
    "allow-set-theme",
    "allow-set-last-entry",
    "allow-kernel-state",
    "allow-set-kernel-channel",
    "allow-connect-kernel",
    "allow-profile-state",
    "allow-add-subscription-profile",
    "allow-add-local-profile",
    "allow-stage-install-link",
    "allow-confirm-install-link",
    "allow-cancel-install-link",
    "allow-enable-profile",
    "allow-update-profile",
    "allow-save-profile-override",
    "allow-connect-session",
    "allow-disconnect-session",
    "allow-set-system-proxy",
    "allow-set-tun-enabled",
    "allow-exclude-package",
    "allow-include-package"
  ]
}
