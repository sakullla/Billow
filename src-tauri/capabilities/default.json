    "allow-set-webdav-settings",
    "allow-test-webdav",
    "allow-upload-backup",
    "allow-list-remote-backups",
    "allow-restore-remote-backup",
    "allow-clear-notice",
    "allow-refresh-kernel",
    "allow-app-info",
    "allow-set-autostart",
    "allow-set-app-behavior",
    "allow-sync-tray",
    "allow-hotkey-settings",
    "allow-set-hotkey",
    "allow-flush-cache",
    "allow-restart-kernel",
    "allow-kernel-gc",
    "allow-kernel-providers",
    "allow-provider-action",
    "allow-upgrade-geo",
    "allow-provider-detail",
    "allow-geo-files",
    "allow-open-uwp-tool",
    "allow-list-uwp-apps",
    "allow-save-uwp-exemptions",
